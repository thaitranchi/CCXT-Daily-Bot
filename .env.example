# Copy this file to `.env` and fill in your real keys.
# `.env` is gitignored -- never commit real credentials.
#
# The variable name must match EXCHANGE_ID in config.py, upper-cased.
#   EXCHANGE_ID = "binance"  ->  BINANCE_API_KEY / BINANCE_API_SECRET
#   EXCHANGE_ID = "bybit"    ->  BYBIT_API_KEY    / BYBIT_API_SECRET
#   EXCHANGE_ID = "okx"      ->  OKX_API_KEY      / OKX_API_SECRET

BINANCE_API_KEY=
BINANCE_API_SECRET=
